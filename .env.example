# Token secreto del Bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=tu_token_secreto_aqui

# Application Client ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=tu_client_id_aqui

# ID del servidor de pruebas (Opcional: Si se define, registra los comandos de inmediato en ese servidor)
GUILD_ID=tu_guild_id_opcional

# Activa los comandos con prefijo (!creating). Requiere Message Content Intent en Discord Developer Portal.
# XP por mensajes solo necesita Guild Messages Intent; las llamadas de voz usan Guild Voice States.
ENABLE_PREFIX_COMMANDS=false

# Prefijo para comandos de texto; se usa "!" si se deja vacío.
PREFIX=!
